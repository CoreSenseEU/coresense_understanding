

#include "behaviortree_ros2/plugins.hpp"

#include "coresense_understanding_interfaces/base64.h"
#include "coresense_understanding_interfaces/get_{{package}}_{{ typ_snake }}_modelet.hpp"

void Get{{ package }}_{{ typ }}ModeletNode::set_coresense_parameter() {
  const std::string path = ament_index_cpp::get_package_share_directory("coresense_understanding_interfaces") + "/config/get_{{ package }}_{{ typ_snake }}_modelet.json";
  const std::ifstream input_stream(path, std::ios_base::binary);

  if (input_stream.fail()) {
    throw std::runtime_error("Failed to open get_{{ package }}_{{ typ_snake }}_modelet.json");
  }
  std::stringstream buffer;
  buffer << input_stream.rdbuf();
  if(auto node = node_.lock()) {
    node->declare_parameter("coresense_engine", buffer.str());
  }
}
  /** 
   * @brief Required callback that allows the user to set the goal message.
   *
   * @param goal The goal to be sent to the action server.
   *
   * @return false if the request should not be sent. In that case,
   * RosActionNode::onFailure(INVALID_GOAL) will be called.
   */
bool Get{{ package }}_{{ typ }}ModeletNode::setRequest(Request::SharedPtr& request) {
  std::string modelet_id;
  getInput("modelet_id", modelet_id);
  triplestar_msgs::msg::QuerySubstitution substitution;
  substitution.variable = "modelet_id";
  substitution.rdf_term = modelet_id;
  request->substitutions.push_back(substitution);
  // must return true if we are ready to send the request
  return true;
}


{{ package }}::msg::{{ typ }} Get{{ package }}_{{ typ }}ModeletNode::create_modelet_from_json(std::string json_string) {
  rclcpp::Serialization<{{ package }}::msg::{{ typ }}> deSerializer;
  {{ package }}::msg::{{ typ }} modelet;
  std::stringstream ss;
  ss << json_string;
  nlohmann::json result = nlohmann::json::parse(ss);
  for (nlohmann::json binding : result["results"]["bindings"]) {
    std::string modelet_id = binding["modelet_id"]["value"].get<std::string>();
    std::string modelet_base64 = binding["modelet_serialized"]["value"].get<std::string>();
    std::vector<uint8_t> modelet_uint8; 
    macaron::Base64::Decode(modelet_base64, modelet_uint8);

    // create serialized message structure
    rclcpp::SerializedMessage serialized_msg(modelet_uint8.size());
    // fill underlying type
    memcpy(serialized_msg.get_rcl_serialized_message().buffer, modelet_uint8.data(), modelet_uint8.size());
    serialized_msg.get_rcl_serialized_message().buffer_length = modelet_uint8.size();
    //deserialize
    deSerializer.deserialize_message(&serialized_msg, &modelet);
  }
  return modelet;
}
  /** 
   * @brief Required callback invoked when the result is received by the server.
   * 
   * It is up to the user to define if the action returns SUCCESS or FAILURE.
   */
BT::NodeStatus Get{{ package }}_{{ typ }}ModeletNode::onResponseReceived(const Response::SharedPtr& response) {
  setOutput("modelet", create_modelet_from_json(response->result));
  return BT::NodeStatus::SUCCESS;
}

  /**
   * @brief Optional callback invoked when something goes wrong. 
   *
   * It must return either SUCCESS or FAILURE.
   */
BT::NodeStatus Get{{ package }}_{{ typ }}ModeletNode::onFailure(BT::ServiceNodeErrorCode error) {
    RCLCPP_ERROR(logger(), "Error: %d", error);
    return BT::NodeStatus::FAILURE;
}



cmake_minimum_required(VERSION 3.8)
project(coresense_understanding_interfaces)

if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  add_compile_options(-Wall -Wextra -Wpedantic)
endif()

# find dependencies
find_package(ament_cmake REQUIRED)
find_package(behaviortree_cpp REQUIRED)
find_package(behaviortree_ros2 REQUIRED)
find_package(pluginlib REQUIRED)
find_package(btcpp_ros2_interfaces REQUIRED)

find_package(triplestar_msgs REQUIRED)

{% for modelet in modelets %}
find_package({{ modelet.package }} REQUIRED)
{% endfor %}


if(BUILD_TESTING)
  find_package(ament_lint_auto REQUIRED)
  # the following line skips the linter which checks for copyrights
  # comment the line when a copyright and license is added to all source files
  set(ament_cmake_copyright_FOUND TRUE)
  # the following line skips cpplint (only works in a git repo)
  # comment the line when this package is in a git repo and when
  # a copyright and license is added to all source files
  set(ament_cmake_cpplint_FOUND TRUE)
  ament_lint_auto_find_test_dependencies()
endif()

set(DEPENDENCIES
  behaviortree_ros2::behaviortree_ros2
  ${btcpp_ros2_interfaces_TARGETS}
  ${triplestar_msgs_TARGETS}
{% for modelet in modelets %}
  ${ {{- modelet.package }}_TARGETS}
{% endfor %}
)

{% for modelet in modelets %}
add_library(get_{{ modelet.package}}_{{ modelet.typ }}_modelet_plugin SHARED src/get_{{ modelet.package}}_{{ modelet.typ }}_modelet.cpp)
target_compile_definitions(get_{{ modelet.package}}_{{ modelet.typ }}_modelet_plugin PRIVATE  BT_PLUGIN_EXPORT )
target_link_libraries(get_{{ modelet.package}}_{{ modelet.typ }}_modelet_plugin
  ${pluginlib_TARGETS}
  ${DEPENDENCIES}
  ament_index_cpp::ament_index_cpp
)

target_include_directories(get_{{ modelet.package}}_{{ modelet.typ }}_modelet_plugin PUBLIC
  $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
  $<INSTALL_INTERFACE:include>
)

{% endfor %}


###############
### Install targets and directories
install(TARGETS
{% for modelet in modelets %}
  get_{{ modelet.package }}_{{ modelet.typ }}_modelet_plugin
{% endfor %}
  DESTINATION lib/${PROJECT_NAME}
)

install(DIRECTORY
  behavior_trees
  config
  # launch
  DESTINATION share/${PROJECT_NAME}
)


# Install plugins for other packages to load
install(TARGETS
{% for modelet in modelets %}
  get_{{ modelet.package}}_{{ modelet.typ }}_modelet_plugin
{% endfor %}
  LIBRARY DESTINATION share/${PROJECT_NAME}/bt_plugins
  ARCHIVE DESTINATION share/${PROJECT_NAME}/bt_plugins
  RUNTIME DESTINATION share/${PROJECT_NAME}/bt_plugins
)


# Install headers for plugins
install(DIRECTORY
  include/
  DESTINATION include
)

ament_package()
